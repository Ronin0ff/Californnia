# ProfitPilot AI — Environment Variables
# Copy this file to .env and fill in the values

# API Base URL (backend server)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Owner emails (comma-separated, for admin panel access)
VITE_OWNER_EMAILS=admin@example.com

# YooKassa (ЮKassa) Payment Configuration
VITE_YUKASSA_SHOP_ID=
VITE_YUKASSA_RETURN_URL=https://your-domain.com/app

# MetaGPTx Web SDK
VITE_METAGPTX_APP_ID=
